# ก๊อปไฟล์นี้เป็น .dev.vars แล้วใส่ค่าจริง (.dev.vars ถูก gitignore ไว้ ห้าม commit)
# บน production ให้ใส่ค่าเดียวกันที่ Cloudflare dashboard → Workers → wheremycv → Settings → Variables and Secrets

# URL ของเว็บ เช่น https://wheremycv.example.com (ตอน dev ใช้ http://localhost:3000)
APP_URL=http://localhost:3000

# สุ่มเอง อย่างน้อย 32 ตัวอักษร: openssl rand -base64 32
AUTH_SECRET=

# LINE userId ที่อนุญาตให้ใช้ (ขึ้นต้นด้วย U) คั่นด้วยจุลภาค — ถ้าว่างจะไม่มีใครเข้าได้
ALLOWED_LINE_USER_IDS=

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# Messaging API channel (LINE OA) — ใช้ส่งแจ้งเตือน
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# ใช้เฉพาะตอน dev บนเครื่อง (localhost) เพื่อล็อกอินโดยไม่ต้องผ่าน LINE — production จะไม่สนใจค่านี้
DEV_LOGIN_LINE_USER_ID=
